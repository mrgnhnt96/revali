{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR/.game_loop_self/.game_loop\"; [ -x \"$d/bin/game_loop\" ] || d=\"$CLAUDE_PROJECT_DIR/.game_loop\"; GAME_LOOP_HOME=\"$CLAUDE_PROJECT_DIR/.game_loop\" exec \"$d\"/bin/game_loop limitgate",
            "timeout": 10,
            "statusMessage": "game_loop: usage-limit handoff gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR/.game_loop_self/.game_loop\"; [ -x \"$d/bin/game_loop\" ] || d=\"$CLAUDE_PROJECT_DIR/.game_loop\"; GAME_LOOP_HOME=\"$CLAUDE_PROJECT_DIR/.game_loop\" exec \"$d\"/bin/game_loop stopgate",
            "timeout": 10,
            "statusMessage": "game_loop: is this turn-end earned?"
          },
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR/.game_loop_self/.game_loop\"; [ -x \"$d/bin/watchdog\" ] || d=\"$CLAUDE_PROJECT_DIR/.game_loop\"; GAME_LOOP_HOME=\"$CLAUDE_PROJECT_DIR/.game_loop\" exec \"$d\"/bin/watchdog",
            "asyncRewake": true,
            "timeout": 604800,
            "statusMessage": "game_loop: arming the idle watchdog"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "gl=\"${CLAUDE_PROJECT_DIR:-.}/.game_loop/bin/game_loop\"; if [ -x \"$gl\" ]; then exec \"$gl\" statusline; else cat >/dev/null; fi",
    "refreshInterval": 60
  }
}
